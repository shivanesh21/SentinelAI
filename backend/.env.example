# LLM provider for Root-Cause Analysis (Module 6)
# Supported: anthropic | openai | local
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local model endpoint (e.g., Ollama) used when LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434

# Remediation safety mode (advisory | approval | autonomous)
REMEDIATION_MODE=approval

# Slack / webhook notification (optional)
SLACK_WEBHOOK_URL=

# MLflow tracking URI (empty = local filesystem ./mlruns)
MLFLOW_TRACKING_URI=file:./mlruns